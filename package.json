{
  "name": "mapeolineal",
  "version": "1.0.0",
  "private": true,
  "description": "Mapeo lineal de intervalos: PWA instalable, offline y responsiva.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./styles.css --watch",
    "icons": "python ./scripts/generate-icons.py",
    "serve": "python -m http.server 8080"
  },
  "devDependencies": {
    "tailwindcss": "3.4.19"
  }
}
